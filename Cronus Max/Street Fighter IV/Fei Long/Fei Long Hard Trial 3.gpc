//Push Dan into the corner and stand exactly 1 square apart

main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
	//Jump Heavy Kick
    set_val(XB360_UP, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_UP, 0);
    set_val(XB360_RIGHT, 0);
    wait(500);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_RT, 0);
    wait(400);
    //Light Punch
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_X, 0);
    wait(300);
    //Crouch MED Punch
    set_val(XB360_DOWN, 100);
    set_val(XB360_Y, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_Y, 0);
    wait(400);
    //Crouch MED Punch
    set_val(XB360_DOWN, 100);
    set_val(XB360_Y, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_Y, 0);
    wait(50);
    //Heavy Rekkashinken
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 0);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_RB, 0);
    

}

