// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
#include <titanone.gph>
#pragma METAINFO("SF4 C Viper Hard Trial 1", 1, 0, "XxFrAsZeRxX")

int i;

main 
{
	if(get_val(XB360_LS))
	{
		i = 1;	
	}
	if(get_val(XB360_RS))
	{
		i = 0;
	}
	if(i==1)
	{
		combo_run(trial);
	}
	if(i==0)
	{
		combo_stop(trial);
	}
}

combo trial
{
	set_val(XB360_UP, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_UP, 0);
    set_val(XB360_RIGHT, 0);
    wait(450);
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_RB, 0);
    wait(400);
    set_val(XB360_Y, 100);
    wait(20);
    set_val(XB360_Y, 0);
    wait(450);
    set_val(XB360_DOWN, 100);
    set_val(XB360_Y, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_Y, 0);
    wait(50);
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 0);
    set_val(XB360_Y, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_Y, 0);
    wait(250);
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 0);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_Y, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_Y, 0);
	i = 0;
}
