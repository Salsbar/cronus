// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
//#include <titanone.gph>
//#pragma METAINFO("SF4 Dhalsim Hard Trial 1", 1, 0, "XxFrAsZeRxX")

main {  if(get_val(XB360_LS)) combo_run(DhalsimT19); 
        if(get_val(XB360_RS)) combo_stop(DhalsimT19); 
}

combo DhalsimT19 {
    set_val(XB360_LEFT, 100);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_LEFT, 0);
    set_val(XB360_B, 0);
    wait(50);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 0);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 0);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_LEFT, 0);
    set_val(XB360_X, 0);
    wait(20);
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_DOWN, 0);
    wait(20);
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_DOWN, 0);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_X, 0);
}
