//#include <titanone.gph>
//#pragma METAINFO("SF4 Ryu Normal Trial 4-1", 1, 0, "XxFrAsZeRxX")
main {
    if(get_val(XB1_RS)) {
        combo_run(Turbo_1);
    }

}

combo Turbo_1 {
	set_val(XB1_RIGHT, 100);
	set_val(XB1_UP, 100);
	wait(500);
	set_val(XB1_RT, 100);
	wait(40);
	set_val(XB1_DOWN, 100);
	wait(500);
	set_val(XB1_DOWN, 100);
	set_val(XB1_B, 100);
	wait(20);
	set_val(XB1_DOWN, 100);
	wait(20);
	set_val(XB1_DOWN, 100);
	set_val(XB1_LEFT, 100);
	wait(20);
	set_val(XB1_LEFT, 100);
	set_val(XB1_B, 100);
	wait(200);
}

