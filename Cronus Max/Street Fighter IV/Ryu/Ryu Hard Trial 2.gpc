//Push the characters all the way to the right, and then tap LEFT 5 times. Activate using LS.
//#include <titanone.gph>
//#pragma METAINFO("SF4 Ryu Hard Trial 2", 1, 0, "XxFrAsZeRxX")
int i;

define lk = XB360_A;
define mk = XB360_B;
define hk = XB360_RT;

define lp = XB360_X;
define mp = XB360_Y;
define hp = XB360_RB;

define LY = XB360_LY;
define LX = XB360_LX;

define d = XB360_DOWN;
define r = XB360_RIGHT;
define l = XB360_LEFT;
define u = XB360_UP;

define p = XB360_LB;
define k = XB360_LT;

main 
{
	if(get_val(XB360_BACK))
	{
		i = 1;
	}
	if(get_val(XB360_RS))
	{
		i = 0;
	}
	
	
	if(i==1)
	{
		combo_run(move1);
	}
	if(i==0)
	{
		combo_stop(move1);
	}
}

combo move1
{
	//Focus Attack
	set(mk);
	set(mp);
	wait(800);
	rel(mk);
	rel(mp);
	wait(115);
	set(r);
	wait(15);
	rel(r);
	wait(15);
	//Solar Plexus Strike
	set(r);
	wait(10);
	rel(r);
	wait(800);
	set(r);
	set(hp);
	wait(50);
	rel(hp);
	wait(950);
	//Crouch Heavy Punch
	set(d);
	set(hp);
	wait(100);
	//Shoruken
	set(r);
	wait(20);
	set(d);
	wait(20);
	set(d);
	set(r);
	set(mp);
	wait(200);
	//Shinku Hadoken
	set(d);
	wait(20);
	set(d);
	set(r);
	wait(20);
	set(r);
	wait(20);
	set(d);
	wait(20);
	set(d);
	set(r);
	wait(20);
	set(r);
	set(hp);
	wait(200);
	i = 0;
}

function set(button)
{
	set_val(button, 100);
}

function rel(button)
{
	set_val(button, 0);
}
