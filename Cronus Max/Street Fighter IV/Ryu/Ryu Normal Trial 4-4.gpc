//#include <titanone.gph>
//#pragma METAINFO("SF4 Ryu Normal Trial 4-4", 1, 0, "XxFrAsZeRxX")
main {
    if(get_val(XB1_RS)) {
        combo_run(Turbo_1);
    }

}

combo Turbo_1 {
	//jump heavy kick
	set_val(XB1_RIGHT, 100);
	set_val(XB1_UP, 100);
	wait(500);
	set_val(XB1_RT, 100);
	wait(200);
	set_val(XB360_RT, 0);
    wait(200);
	//heavy punch
	set_val(XB1_RB, 100);
	wait(80);
	set_val(XB1_RB, 0);
	wait(100);
	//Shoryuken
	set_val(XB1_RIGHT, 100);
	wait(20);
	set_val(XB1_DOWN, 100);
	wait(20);
	set_val(XB1_RIGHT, 100);
	set_val(XB1_DOWN, 100);
	set_val(XB1_X, 100);
	wait(20);
	//Shinku Hadoken
	set_val(XB1_DOWN, 100);
	wait(20);
	set_val(XB1_DOWN, 100);
	set_val(XB1_RIGHT, 100);
	wait(20);
	set_val(XB1_RIGHT, 100);
	wait(20);
	set_val(XB1_DOWN, 100);
	wait(20);
	set_val(XB1_DOWN, 100);
	set_val(XB1_RIGHT, 100);
	wait(20);
	set_val(XB1_RIGHT, 100);
	set_val(XB1_X, 100);
	wait(10);
}

