//Created and/or amended by Dr Marty. 
//I need to thank JayD101 for providing some of the source material.
//Also thanks to XxFrAsZeRxX for a crash course in CronusMax scripting.
//Lastly, thanks goes to James Nguyen (siky) for some details on game mechanics 

main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
	//Crouch Light Kick (Do NOT start this in the corner. You have to be as close as possible to Dan)
	set_val(XB360_DOWN, 100);
    set_val(XB360_A, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_A, 0);
    wait(325);
    //Heavy Punch
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_RB, 0);
    wait(20);
    //Light Shunpukyaku
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_LEFT, 100);
    set_val(XB360_A, 100);
    wait(20);
    set_val(XB360_LEFT, 0);
    set_val(XB360_A, 0);
    wait(990);
    //Crouch Light Kick
    set_val(XB360_DOWN, 100);
    set_val(XB360_A, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_A, 0);
    wait(100);
    //EX Shunpukyaku
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_LEFT, 100);
    set_val(XB360_LT, 100);
    wait(20);
    set_val(XB360_LEFT, 0);
    set_val(XB360_LT, 0);
    wait(1950);
    //Sakura Otoshi
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 0);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_RT, 0);
    wait(150);
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_RB, 0);
    wait(425);
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_RB, 0);
    wait(500);
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_RB, 0);

}

