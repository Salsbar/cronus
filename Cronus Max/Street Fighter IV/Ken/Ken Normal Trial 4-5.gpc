//a bit finicky. don't stand too far away from Dan, otherwise the Target Combo won't connect. 
//#include <titanone.gph>
//#pragma METAINFO("SF4 Ken Normal Trial 4-5", 1, 0, "XxFrAsZeRxX")
main {
    if(get_val(XB1_RS)) {
        combo_run(Turbo_1);
    }

}

combo Turbo_1 {
	//jump heavy kick
	set_val(XB1_RIGHT, 100);
	set_val(XB1_UP, 100);
	wait(500);
	set_val(XB1_RT, 100);
	wait(20);
	set_val(XB1_RT, 0);
	wait(500);
	//Target Combo (medium punch to hard punch)
    set_val(XB1_Y, 100);
    wait(20);
    set_val(XB1_Y, 0);
    wait(150);
    set_val(XB1_RB, 100);
    wait(20);
    set_val(XB1_RB, 100);
    wait(150);
	//Medium Shoryuken
	set_val(XB1_RIGHT, 100);
	wait(20);
	set_val(XB1_DOWN, 100);
	wait(20);
	set_val(XB1_RIGHT, 100);
	set_val(XB1_DOWN, 100);
	set_val(XB1_X, 100);
    wait(20);
    set_val(XB1_X, 0);
    set_val(XB1_RIGHT, 0);
	wait(50);
	//Shoryureppa
	set_val(XB1_DOWN, 100);
	wait(20);
	set_val(XB1_DOWN, 100);
	set_val(XB1_RIGHT, 100);
	wait(20);
	set_val(XB1_RIGHT, 100);
	wait(20);
	set_val(XB1_DOWN, 100);
	wait(20);
	set_val(XB1_DOWN, 100);
	set_val(XB1_RIGHT, 100);
	wait(20);
	set_val(XB1_RIGHT, 100);
	set_val(XB1_X, 100);
    wait(20);
    set_val(XB1_X, 0);
    set_val(XB1_RIGHT, 0);
}

