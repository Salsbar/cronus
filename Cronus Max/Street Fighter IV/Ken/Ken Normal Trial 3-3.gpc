//#include <titanone.gph>
//#pragma METAINFO("SF4 Ken Normal Trial 3-3", 1, 0, "XxFrAsZeRxX")
main {
    if(get_val(XB1_RS)) {
        combo_run(Turbo_1);
    }

}

combo Turbo_1 {
	//Target Combo (medium punch to hard punch)
	set_val(XB1_Y, 100);
	wait(20);
	set_val(XB1_Y, 0);
	wait(20);
	set_val(XB1_RB, 100);
	wait(20);
	set_val(XB1_RB, 0);
	wait(200);
	//Shoryuken
	set_val(XB1_RIGHT, 100);
	wait(20);
	set_val(XB1_DOWN, 100);
	wait(20);
	set_val(XB1_DOWN, 100);
	set_val(XB1_RIGHT, 100);
	set_val(XB1_Y, 100);
	wait(200);
}

