// Requires manual final input (A+X)
//#include <titanone.gph>
//#pragma METAINFO("SF4 Ken Normal Trial 4-3", 1, 0, "XxFrAsZeRxX")
main {
    if(get_val(XB1_RS)) {
        combo_run(Turbo_1);
    }

}

combo Turbo_1 {
	//jump heavy kick
	set_val(XB1_RIGHT, 100);
	set_val(XB1_UP, 100);
	wait(500);
	set_val(XB1_RT, 100);
	wait(20);
	set_val(XB1_RT, 0);
	wait(350);
	//heavy kick
	set_val(XB1_RT, 100);
	wait(20);
	set_val(XB1_RT, 0);
	wait(200);
	//Medium Shoryuken
	set_val(XB1_RIGHT, 100);
	wait(20);
	set_val(XB1_DOWN, 100);
	wait(20);
	set_val(XB1_RIGHT, 100);
	set_val(XB1_DOWN, 100);
	set_val(XB1_Y, 100);
    wait(20);
    set_val(XB1_Y, 0);
    set_val(XB1_RIGHT, 0);
	wait(50);
	//EX Focus Attack (timing needs to be fixed below)
    set_val(XB1_Y, 100);
    set_val(XB1_B, 100);
    wait(20);
    set_val(XB1_Y, 0);
    set_val(XB1_B, 0);
    wait(150);
}

