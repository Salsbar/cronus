//Push the characters all the way to the right, and then tap LEFT 7 times. Activate using LS. It may take a couple attempts.
//#include <titanone.gph>
//#pragma METAINFO("SF4 Ken Hard Trial 4", 1, 0, "XxFrAsZeRxX")
int i;

define lk = XB360_A;
define mk = XB360_B;
define hk = XB360_RT;

define lp = XB360_X;
define mp = XB360_Y;
define hp = XB360_RB;

define LY = XB360_LY;
define LX = XB360_LX;

define d = XB360_DOWN;
define r = XB360_RIGHT;
define l = XB360_LEFT;
define u = XB360_UP;

define p = XB360_LB;
define k = XB360_LT;

main 
{
	if(get_val(XB360_BACK))
	{
		i = 1;
	}
	if(get_val(XB360_RS))
	{
		i = 0;
	}
	
	
	if(i==1)
	{
		combo_run(move1);
	}
	if(i==2)
	{
		combo_run(move2);
	}
	if(i==0)
	{
		combo_stop(move1);
	}
}

combo move1
{
	//Jump Heavy Kick
	set(u);
	set(r);
	wait(531);
	set(hk);
	wait(400);
	//Crouch Light Punch
	set(d);
	set(lp);
	wait(315);
	//Crouch Heavy Punch
	set(d);
	set(hp);
	wait(250);
	//Shoryuken
	rel(lp);
	set(r);
	wait(25);
	set(d);
	wait(25);
	set(d);
	set(r);
	set(hp);
	wait(315);
	//EX Focus Cancel
	set(mp);
	set(mk);
	wait(100);
	set(r);
	wait(5);
	rel(r);
	wait(5);
	set(r);
	wait(250);
	i = i + 1;
}

combo move2
{
	//Shoryuken
	set(r);
	rel(mp);
	wait(20);
	set(d);
	set(l);
	wait(20);
	set(r);
	set(d);
	set(mp);
	wait(1000);
	//Shinryuken
	set(d);
	wait(25);
	set(d);
	set(r);
	wait(25);
	set(r);
	wait(25);
	set(d);
	wait(25);
	set(d);
	set(r);
	wait(25);
	set(r);
	wait(25);
	set(p);
	wait(50);
	i = 0;
}

function set(button)
{
	set_val(button, 100);
}

function rel(button)
{
	set_val(button, 0);
}
