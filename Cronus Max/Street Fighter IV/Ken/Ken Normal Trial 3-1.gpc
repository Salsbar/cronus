//#include <titanone.gph>
//#pragma METAINFO("SF4 Ken Normal Trial 3-1", 1, 0, "XxFrAsZeRxX")
main {
    if(get_val(XB1_RS)) {
        combo_run(Turbo_1);
    }

}

combo Turbo_1 {
	set_val(XB1_RT, 100);
	wait(20);
	set_val(XB1_RT, 0);
	wait(20);
	set_val(XB1_DOWN, 100);
	wait(20);
	set_val(XB1_DOWN, 100);
	set_val(XB1_RIGHT, 100);
	wait(20);
	set_val(XB1_RIGHT, 100);
	set_val(XB1_RB, 100);
	wait(200);
}

