//#include <titanone.gph>
//#pragma METAINFO("SF4 Ken Normal Trial 4-2", 1, 0, "XxFrAsZeRxX")
main {
    if(get_val(XB1_RS)) {
        combo_run(Turbo_1);
    }

}

combo Turbo_1 {
	//jump heavy punch
	set_val(XB1_RIGHT, 100);
	set_val(XB1_UP, 100);
	wait(500);
	set_val(XB1_RB, 100);
	wait(40);
	//crouch heavy punch
	set_val(XB1_DOWN, 100);
	wait(400);
	set_val(XB1_DOWN, 100);
	set_val(XB1_RB, 100);
	wait(20);
	//Tatsumaki Senpukyaku
	set_val(XB1_DOWN, 100);
	wait(20);
	set_val(XB1_DOWN, 100);
	set_val(XB1_LEFT, 100);
	wait(20);
	set_val(XB1_LEFT, 100);
	set_val(XB1_B, 100);
	wait(200);
}

