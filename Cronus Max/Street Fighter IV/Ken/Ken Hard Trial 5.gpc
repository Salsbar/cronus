main {  if(get_val(XB360_LS)) combo_run(KenT24); 
        if(get_val(XB360_RS)) combo_stop(KenT24); 
}

combo KenT24 {
    set_val(XB360_UP, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_UP, 0);
    set_val(XB360_RIGHT, 0);
    wait(450);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_RT, 0);
    wait(450);
    set_val(XB360_DOWN, 100);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_X, 0);
    wait(300);
    set_val(XB360_DOWN, 100);
    set_val(XB360_Y, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_Y, 0);
    wait(50);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 0);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_RB, 0);
    wait(400);
    set_val(XB360_Y, 100);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_Y, 0);
    set_val(XB360_B, 0);
    wait(20);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    wait(20);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    wait(400);
    set_val(XB360_UP, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_UP, 0);
    set_val(XB360_RIGHT, 0);
    wait(100);
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_LEFT, 100);
    set_val(XB360_B, 100);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_LEFT, 0);
    set_val(XB360_B, 0);
    set_val(XB360_RT, 0);
    wait(800);
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_LB, 100);
    wait(100);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_LB, 0);
