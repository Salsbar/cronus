main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
    //Jump Heavy Kick
    set_val(XB360_UP, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_UP, 0);
    wait(450);
    set_val(XB360_LEFT, 100);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_RT, 0);
    wait(450);
    //Crouch MED Kick
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 100);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 0);
    set_val(XB360_B, 0);
    wait(150);
    //Sumo Headbutt
    set_val(XB360_LEFT, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_RB, 100);
    wait(20);
	
	set_val(XB360_LEFT, 100);
	wait(150);
    set_val(XB360_RIGHT, 100);
    wait(20);
	set_val(XB360_LEFT, 0);
	wait(20);
    //Super Killer Head Ram
    set_val(XB360_LEFT, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_X, 100);

}

