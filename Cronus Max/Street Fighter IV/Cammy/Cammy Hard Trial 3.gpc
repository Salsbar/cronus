// Hit Dan in the knees with the first move

main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
	//Cannon Strike
    set_val(XB360_UP, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_UP, 0);
    set_val(XB360_RIGHT, 0);
    wait(175);
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_LEFT, 100);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_RT, 0);
    wait(725);
    //Light Kick
    set_val(XB360_A, 100);
    wait(20);
    set_val(XB360_A, 0);
    wait(325);
    //Heavy Punch
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_RB, 0);
    wait(50);
    //Cannon Spike
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 0);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_A, 100);
    wait(20);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_A, 0);
    

}

