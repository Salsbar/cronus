// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
//#include <titanone.gph>
//#pragma METAINFO("SF4 Balrog Hard Trial 3", 1, 0, "XxFrAsZeRxX")

// Push Dan to the right all the way and back off slightly.

main {  if(get_val(XB360_LS)) combo_run(BalrogT22); 
        if(get_val(XB360_RS)) combo_stop(BalrogT22); 
}

combo BalrogT22 {
    set_val(XB360_UP, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_UP, 0);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_LEFT, 100);
    wait(500);
    set_val(XB360_LEFT, 100);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_RB, 0);
    wait(375);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    set_val(XB360_X, 0);
    wait(250);
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 100);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 0);
    set_val(XB360_X, 0);
    wait(250);
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 100);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_X, 0);
    wait(275);
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 100);
    set_val(XB360_Y, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 0);
    set_val(XB360_Y, 0);
    wait(300);
    set_val(XB360_LEFT, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_X, 100);
    wait(75);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_X, 0);
    wait(75);
    set_val(XB360_LEFT, 100);
    wait(75);
    set_val(XB360_LEFT, 0);
    wait(75);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_X, 100);
    wait(75);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_X, 0);

}
