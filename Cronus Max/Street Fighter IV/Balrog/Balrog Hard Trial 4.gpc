main {  if(get_val(XB360_LS)) combo_run(BalrogT23); 
        if(get_val(XB360_RS)) combo_stop(BalrogT23); 
}

combo BalrogT23 {
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    wait(1000);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    set_val(XB360_X, 0);
    wait(300);
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 100);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 100);
    set_val(XB360_X, 0);
    wait(20);
    set_val(XB360_LEFT, 0);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_LT, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_LT, 0);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    wait(825);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    set_val(XB360_X, 0);
    wait(300);
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 100);
    set_val(XB360_A, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 100);
    set_val(XB360_A, 0);
    wait(50);
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 0);
    set_val(XB360_UP, 100);
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_UP, 0);
    set_val(XB360_RB, 0);
    wait(750);
    set_val(XB360_RIGHT, 100);
    wait(75);
    set_val(XB360_RIGHT, 0);
    wait(75);
    set_val(XB360_LEFT, 100);
    wait(75);
    set_val(XB360_LEFT, 0);
    wait(75);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_LT, 100);
    wait(75);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_LT, 0);

}
