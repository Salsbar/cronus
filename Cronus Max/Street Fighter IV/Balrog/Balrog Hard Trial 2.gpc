// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
//#include <titanone.gph>
//#pragma METAINFO("SF4 Balrog Hard Trial 2", 1, 0, "XxFrAsZeRxX")

//Get as close as possible, move all the way to the right, and activate.
int i;

define lk = XB360_A;
define mk = XB360_B;
define hk = XB360_RT;

define lp = XB360_X;
define mp = XB360_Y;
define hp = XB360_RB;

define LY = XB360_LY;
define LX = XB360_LX;

define d = XB360_DOWN;
define r = XB360_RIGHT;
define l = XB360_LEFT;
define u = XB360_UP;

define p = XB360_LB;
define k = XB360_LT;

main { // block start
                                                       
    if(event_press(XB360_LS   ))combo_run(move1);
                                                       
    if(event_press(XB360_RS))combo_stop(move1);
                                                       
}// main block end

combo move1 
{
	set(lp);
	wait(20);
	rel(lp);
	wait(300);
	set(lp);
	wait(20);
	rel(lp);
	wait(300);
	set(lp);
	wait(20);
	rel(lp);
	wait(300);
	set(lp);
	wait(20);
	rel(lp);
	wait(260);
	set(d);
	set(hk);
	wait(100);
	i = 0;
}

combo dashf
{
	set(r);
	wait(25);
	rel(r);
	wait(25);
	set(r);
	wait(25);
	rel(r);
	wait(25);
}

function set(button)
{
	set_val(button, 100);
}

function rel(button)
{
	set_val(button, 0);
}
