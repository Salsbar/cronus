main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
	//Jump Heavy Punch (Mantis) - (Push Dan into the corner and stand 1.5 squares apart)
	set_val(XB360_UP, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_UP, 0);
    set_val(XB360_RIGHT, 0);
    wait(450);
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_RB, 0);
    wait(400);
    //Light Punch (Mantis)
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_X, 0);
    wait(50);
    //Hyakurenki
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_X, 0);
    wait(50);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_X, 0);
    wait(50);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_X, 0);
    wait(50);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_X, 0);
    wait(50);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_X, 0);
    

}

