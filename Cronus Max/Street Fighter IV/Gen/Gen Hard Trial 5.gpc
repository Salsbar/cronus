main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
	//Shakudan (in Crane Style)
    set_val(XB360_UP, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_UP, 0);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_LEFT, 100);
    wait(400);
    set_val(XB360_LEFT, 100);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_RT, 0);
    wait(300);
    set_val(XB360_LEFT, 100);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_RT, 0);
    wait(20);
    //Switch Style
    set_val(XB360_LB, 100);
    wait(20);
    set_val(XB360_LB, 0);
    wait(400);
	//Crouch Light Punch (Mantis)
    set_val(XB360_DOWN, 100);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_X, 0);
    wait(325);
    //MED Punch (Mantis)
    set_val(XB360_Y, 100);
    wait(20);
    set_val(XB360_Y, 0);
    wait(50);
    //Hyakurenko
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_X, 0);
    wait(50);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_X, 0);
    wait(50);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_X, 0);
    wait(50);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_X, 0);
    wait(20);
    //Zan'ei
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 0);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_X, 0);
    wait(2200);
    //Heavy Gekiro (complete)
    set_val(XB360_LEFT, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 0);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_LEFT, 100);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_LEFT, 0);
    set_val(XB360_RT, 0);
    wait(650);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_RT, 0);
    wait(500);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_RT, 0);
    wait(500);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_RT, 0);
    wait(500);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_RT, 0);
    wait(300);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_RT, 0);
    wait(300);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_RT, 0);
    wait(150);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_RT, 0);
    wait(150);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_RT, 0);
    

}

