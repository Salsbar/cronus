main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
	//Jump Heavy Kick (Mantis) - (Push Dan into the corner and stand 1.5 squares apart)
    set_val(XB360_UP, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_UP, 0);
    set_val(XB360_RIGHT, 0);
    wait(450);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_RT, 0);
    wait(400);
    //MED Punch (Mantis)
    set_val(XB360_Y, 100);
    wait(20);
    set_val(XB360_Y, 0);
    wait(50);
    //EX Gekiro (complete)
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 0);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_LT, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_LT, 0);
    wait(750);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_B, 0);
    wait(500);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_B, 0);
    wait(200);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_B, 0);
    wait(200);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_B, 0);
    wait(200);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_B, 0);
    wait(200);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_B, 0);
    wait(200);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_B, 0);
    wait(200);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_B, 0);
    wait(200);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_B, 0);
    

}

