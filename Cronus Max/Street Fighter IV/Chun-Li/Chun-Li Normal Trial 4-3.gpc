main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
    //Focus Attack
    set_val(XB1_Y, 100);
    set_val(XB1_B, 100);
    wait(500);
    set_val(XB1_Y, 0);
    set_val(XB1_B, 0);
    wait(20);
    set_val(XB1_RIGHT, 100);
    wait(20);
    set_val(XB1_RIGHT, 0);
    wait(20);
    set_val(XB1_RIGHT, 100);
    wait(20);
    set_val(XB1_RIGHT, 0);
	  set_val(XB1_DOWN, 100);
    wait(600);
    //Crouch Heavy Punch (once the HP lands, keep holding down)
    set_val(XB1_DOWN, 100);
    set_val(XB1_RT, 100);
    wait(20);
    set_val(XB1_DOWN, 100);
    set_val(XB1_RT, 0);
    wait(400);
    set_val(XB1_DOWN, 100);
    set_val(XB1_RB, 100);
    wait(20);
    set_val(XB1_DOWN, 100);
    set_val(XB1_RB, 0);
    wait(275);
    //MED Spinning Bird Kick
    set_val(XB1_DOWN, 0);
    set_val(XB1_UP, 100);
    set_val(XB1_B, 100);
    wait(20);
    set_val(XB1_UP , 0);
    set_val(XB1_B, 0);
}

