main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
    //Focus Attack into medium punch
    set_val(XB1_Y, 100);
    set_val(XB1_B, 100);
    wait(500);
    set_val(XB1_Y, 0);
    set_val(XB1_B, 0);
    wait(20);
    set_val(XB1_RIGHT, 100);
    wait(20);
    set_val(XB1_RIGHT, 0);
    wait(20);
    set_val(XB1_RIGHT, 100);
    wait(20);
    set_val(XB1_RIGHT, 0);
    set_val(XB1_LEFT, 100);
    wait(500);
    set_val(XB1_RT, 100);
    set_val(XB1_LEFT, 100);
    wait(20);
    set_val(XB1_RT, 0);
    set_val(XB1_LEFT, 100);
    wait(400);
    set_val(XB1_LEFT, 100);
    set_val(XB1_Y, 100);
    wait(20);
    set_val(XB1_LEFT, 100);
    set_val(XB1_Y, 0);
    wait(100);
	//Senretsukyaku
	set_val(XB1_RIGHT, 100);
	wait(20);
	set_val(XB1_LEFT, 100);
	wait(20);
	set_val(XB1_RIGHT, 100);
	set_val(XB1_B, 100);
	wait(100);
}

