//Created and/or amended by Dr Marty. 
//I need to thank JayD101 for providing some of the source material.
//Also thanks to XxFrAsZeRxX for a crash course in CronusMax scripting.
//Lastly, thanks goes to James Nguyen (siky) for some details on game mechanics 

main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
	//Target Combo
    set_val(XB360_UP, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_UP, 0);
    set_val(XB360_RIGHT, 0);
    wait(500);
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_RB, 0);
    wait(150);
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_RB, 0);
    wait(500);
    //Kintekishu
    set_val(XB360_LEFT, 100);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_LEFT , 0);
    set_val(XB360_B, 0);
    wait(100);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_B, 0);
    wait(300);
    //Tenkukyaku
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_UP, 100);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    wait(150);
    //Tenshokyaku
    set_val(XB360_UP, 0);
    set_val(XB360_B, 0);
    //EX Spinning Bird Kick
    set_val(XB360_DOWN, 100);
    wait(1500);
    set_val(XB360_DOWN, 0);
    set_val(XB360_UP, 100);
    set_val(XB360_B, 100);
    set_val(XB360_A, 100);
    wait(20);
    set_val(XB360_UP, 0);
    set_val(XB360_B, 0);
    set_val(XB360_A, 0);
}

