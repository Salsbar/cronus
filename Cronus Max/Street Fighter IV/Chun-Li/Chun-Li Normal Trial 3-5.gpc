//as soon as chun-li jumps up again keep DOWN pressed and mash the B button. Activate just before Dan hits the ground

main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
	//Target Combo (Jump, 2x Heavy Punch)
	set_val(XB1_RIGHT, 100);
	set_val(XB1_UP, 100);
	wait(450);
	set_val(XB1_RB, 100);
	wait(20);
	set_val(XB1_RB, 0);
	wait(10);
	set_val(XB1_RB, 100);
	wait(20);
	set_val(XB1_RB, 0);
	wait(10);
	set_val(XB1_RB, 100);
	wait(20);
	set_val(XB1_RB, 0);
	wait(600);
	//Yosokyaku 3x
	set_val(XB1_UP, 100);
	set_val(XB1_RIGHT, 100);
	wait(200);
	//at this point manually input the following
	//as soon as chun-li jumps up again keep DOWN pressed and mash the B button
	
}

