// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
//#include <titanone.gph>
//#pragma METAINFO("SF4 Chun-Li Normal Trial 2-5", 1, 0, "XxFrAsZeRxX")

main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
	//Senretsukyaku
	set_val(XB1_LEFT, 100);
	set_val(XB1_DOWN, 100);
	wait(1000);
	set_val(XB1_LEFT, 100)
	wait(100);
	set_val(XB1_RIGHT, 100);
	wait(20);
	set_val(XB1_LEFT, 100);
	wait(20);
	set_val(XB1_RIGHT, 100);
	set_val(XB1_B, 100);
	wait(100);
}

