main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {

    set_val(XB1_UP, 100);
    set_val(XB1_RIGHT, 100);
    wait(20);
    set_val(XB1_UP, 0);
    set_val(XB1_RIGHT, 0);
    wait(600);
    set_val(XB1_RT, 100);
    wait(20);
    set_val(XB1_RT, 0);
    wait(400);
    set_val(XB1_LEFT, 100);
    set_val(XB1_B, 100);
    wait(20);
    set_val(XB1_LEFT, 0);
    set_val(XB1_B, 0);
    wait(75);
    set_val(XB1_LEFT, 0);
    set_val(XB1_B, 100);
    wait(20);
    set_val(XB1_LEFT, 100);
    set_val(XB1_B, 0);
    wait(400);
	
	
    set_val(XB1_LEFT, 100);
    set_val(XB1_LT, 100);
    wait(75);
    set_val(XB1_LEFT, 100);
    set_val(XB1_LT, 0);
    wait(75);
    set_val(XB1_LEFT, 100);
    set_val(XB1_LT, 100);
    wait(75);
    set_val(XB1_LEFT, 100);
    set_val(XB1_LT, 0);
    wait(75);
    set_val(XB1_LEFT, 100);
    set_val(XB1_LT, 100);
    wait(75);
    set_val(XB1_LEFT, 100);
    set_val(XB1_LT, 0);
    wait(75);
    set_val(XB1_LEFT, 100);
    set_val(XB1_LT, 100);
    wait(75);
    set_val(XB1_LEFT, 100);
    set_val(XB1_LT, 0);
    wait(70);
    set_val(XB1_LEFT, 100);
    set_val(XB1_LT, 100);
    wait(70);
    set_val(XB1_LEFT, 100);
    set_val(XB1_LT, 0);
    wait(70);
    set_val(XB1_LEFT, 100);
    set_val(XB1_LT, 100);
    wait(70);
    set_val(XB1_LEFT, 100);
    set_val(XB1_LT, 0);
	wait(70);
    set_val(XB1_LEFT, 100);
    set_val(XB1_LT, 100);
    wait(70);
    set_val(XB1_LEFT, 100);
    set_val(XB1_LT, 0);
	
	
    wait(750);
    set_val(XB1_RIGHT, 100);
    wait(20);
    set_val(XB1_RIGHT, 0);
    wait(20);
    set_val(XB1_LEFT, 100);
    wait(20);
    set_val(XB1_LEFT, 0);
    wait(20);
    set_val(XB1_RIGHT, 100);
    set_val(XB1_LT, 100);
    wait(20);
    set_val(XB1_LEFT, 0);
    set_val(XB1_LT, 0);
}

