// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
//#include <titanone.gph>
//#pragma METAINFO("SF4 Chun-Li Hard Trial 4", 1, 0, "XxFrAsZeRxX")

main {  if(get_val(XB360_LS)) combo_run(ChunLiT19); 
        if(get_val(XB360_RS)) combo_stop(ChunLiT19); 
}

combo ChunLiT19 {
    set_val(XB360_UP, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_UP, 0);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_DOWN, 100);
    wait(500);
    set_val(XB360_RB, 100);
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_RB, 0);
    set_val(XB360_DOWN, 100);
    wait(150);
    set_val(XB360_RB, 100);
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_RB, 0);
    set_val(XB360_DOWN, 100);
    wait(500);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RB, 100);
    wait(300);
    set_val(XB360_LEFT , 100);
    set_val(XB360_UP, 100);
    set_val(XB360_B, 100);
    set_val(XB360_RB, 0);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_UP, 0);
    set_val(XB360_B, 0);
    wait(1600);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_LEFT, 100);
    wait(20);
    set_val(XB360_LEFT, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_RT, 0);

}
