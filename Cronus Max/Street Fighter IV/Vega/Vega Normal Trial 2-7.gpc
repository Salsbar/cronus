//for this part timing is very difficult to script because it depends on where you are in the arena
//just let the script play out and when you're close to Dan, hold BACK and X.

main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
	//Flying Barcelona Special into Rolling Izuna Drop
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    wait(2000);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_LEFT, 0);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_LEFT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_UP, 100);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_UP, 0);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_B, 0);
    wait(1000);
    //Rolling Izuna Drop
	

}

