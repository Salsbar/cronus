// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
//#include <titanone.gph>
//#pragma METAINFO("SF4 Vega Hard Trial 3", 1, 0, "XxFrAsZeRxX")

main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}

combo trial {
	//Jump Heavy Kick
    set_val(XB360_UP, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_UP, 0);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_DOWN, 100);
    wait(500);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RT, 100);
    wait(50);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RT, 0);
    wait(400);
    //Crouch MED Kick
    set_val(XB360_DOWN, 100);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_B, 0);
    wait(475);
    //Crouch Light Punch
    set_val(XB360_DOWN, 100);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_X, 0);
    wait(50);
    //EX Flying Barcelona Attack
    set_val(XB360_RIGHT, 100);
    set_val(XB360_UP, 100);
    set_val(XB360_LT, 100);
    wait(20);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_UP, 0);
    set_val(XB360_LT, 0);
    wait(800);
    //Izuna Drop
    //After the wall jump and when you approach Dan, press LEFT+X
    //It is difficult to judge how long the wall jump will take depending on where in the arena you're standing as well as which wall Vega jumps off of.


}

