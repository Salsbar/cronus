// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
//#include <titanone.gph>
//#pragma METAINFO("SF4 Vega Hard Trial 4", 1, 0, "XxFrAsZeRxX")

main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}

combo trial {
	//Jump Heavy Punch
    set_val(XB360_UP, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_UP, 0);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_DOWN, 100);
    wait(525);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RB, 0);
    wait(300);
    //Heavy Punch
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_RB, 0);
    wait(980);
    //Light Kick
    set_val(XB360_A, 100);
    wait(20);
    set_val(XB360_A, 0);
    wait(350);
    //Crouch MED Punch
    set_val(XB360_DOWN, 100);
    set_val(XB360_Y, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_Y, 0);

}

