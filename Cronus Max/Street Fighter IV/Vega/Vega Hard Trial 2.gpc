// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
//#include <titanone.gph>
//#pragma METAINFO("SF4 Vega Hard Trial 2", 1, 0, "XxFrAsZeRxX")

main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}

combo trial {
    set_val(XB360_UP, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_UP, 0);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 100);
    wait(500);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    set_val(XB360_RB, 100);
    wait(50);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    set_val(XB360_RB, 0);
    wait(450);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    set_val(XB360_X, 0);
    wait(325);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    set_val(XB360_A, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    set_val(XB360_A, 0);
    wait(50);
    set_val(XB360_DOWN, 0);
    set_val(XB360_LEFT, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_A, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_A, 0);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    wait(1000);
    set_val(XB360_DOWN, 0);
    set_val(XB360_LEFT, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_LT, 100);
    wait(20);
    set_val(XB360_LT, 0);
    set_val(XB360_RIGHT, 0);

}
