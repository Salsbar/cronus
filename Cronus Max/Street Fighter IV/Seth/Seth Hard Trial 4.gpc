//Created and/or amended by Dr Marty. 
//I need to thank JayD101 for providing some of the source material.
//Also thanks to XxFrAsZeRxX for a crash course in CronusMax scripting.
//Lastly, thanks goes to James Nguyen (siky) for some details on game mechanics 

main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
	//Crouch Light Kick (Push Dan into the corner first)
    set_val(XB360_DOWN, 100);
    set_val(XB360_A, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_A, 0);
    wait(250);
    //Crouch Light Punch
    set_val(XB360_DOWN, 100);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_X, 0);
    wait(325);
    //Heavy Punch
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_RB, 0);
    wait(50);
    //EX Sonic Boom
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_LB, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_LB, 0);
    wait(500);
    //EX Focus Attack
    set_val(XB360_Y, 100);
    set_val(XB360_B, 100);
    wait(475);
    set_val(XB360_Y, 0);
    set_val(XB360_B, 0);
    wait(50);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    wait(20);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    wait(1000);
    //Tanden Stream
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_LB, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_LB, 0);
    

}

