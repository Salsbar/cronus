//Push Dan into the corner. Stand 1.5 squares apart

main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
	//Tenmakujinkyaku ()
    set_val(XB360_UP, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_UP, 0);
    set_val(XB360_RIGHT, 0);
    wait(350);
    set_val(XB360_DOWN, 100);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_B, 0);
    wait(600);
    //Crouch MED Punch
    set_val(XB360_DOWN, 100);
    set_val(XB360_Y, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_Y, 0);
    wait(50);
    //Heavy Tatsumaki Gorasen
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_LEFT, 100);
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_RT, 0);

}

