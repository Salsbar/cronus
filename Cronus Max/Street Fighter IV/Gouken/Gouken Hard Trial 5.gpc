// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
//#include <titanone.gph>
//#pragma METAINFO("SF4 Gouken Hard Trial 5", 1, 0, "XxFrAsZeRxX")

//Created and/or amended by Dr Marty. 
//I need to thank JayD101 for providing some of the source material.
//Also thanks to XxFrAsZeRxX for a crash course in CronusMax scripting.
//Lastly, thanks goes to James Nguyen (siky) for some details on game mechanics 

main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
	//Gohadoken (This one must be started from an exact position. Push Dan into the corner. 
	//			Now move Gouken so that he is about 1 square away from Dan, so that the thick black line is between his big toe and the other toes.
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_X, 0);
    wait(300);
    //EX Focus Attack
    set_val(XB360_Y, 100);
    set_val(XB360_B, 100);
    wait(300);
    set_val(XB360_Y, 0);
    set_val(XB360_B, 0);
    wait(50);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    wait(20);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    wait(1000);
    //Crouch Heavy Punch
    set_val(XB360_DOWN, 100);
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RB, 0);
    wait(50);
    //EX Senkugoshoha
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 0);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_LB, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_LB, 0);
    wait(2000);
    //EX Gohadoken
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_LB, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_LB, 0);
    wait(800);
    //Shin Shoryuken
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 0);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_LB, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_LB, 0);

}

