// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
//#include <titanone.gph>
//#pragma METAINFO("SF4 M Bison Hard Trial 1", 1, 0, "XxFrAsZeRxX")

//Start one all the way to the right facing to the right.

int i;

main 
{
	if(get_val(XB360_LS))
	{
		i = 1;	
	}
	if(get_val(XB360_RS))
	{
		i = 0;
	}
	if(i==1)
	{
		combo_run(trial);
	}
	if(i==0)
	{
		combo_stop(trial);
	}
}

combo trial
{
	set_val(PS4_LY, 100);
	wait(1350);
	set_val(PS4_LY, 0);
	wait(30);
	set_val(PS4_LY, -100);
	wait(30);
	set_val(PS4_LY, -100);
	set_val(PS4_CIRCLE, 100);
	wait(130);
	set_val(PS4_LY, -100);
	set_val(PS4_CIRCLE, 0);
	wait(40);
	set_val(PS4_LY, 0);
	wait(1220);
	set_val(PS4_LY, 100);
	set_val(PS4_TRIANGLE, 100);
	wait(90);
	set_val(PS4_LY, 100);
	set_val(PS4_TRIANGLE, 0);
	wait(110);
	set_val(PS4_LY, 100);
	set_val(PS4_TRIANGLE, 100);
	wait(70);
	set_val(PS4_LY, 100);
	set_val(PS4_TRIANGLE, 0);
	wait(90);
	set_val(PS4_LY, 100);
	set_val(PS4_TRIANGLE, 100);
	wait(50);
	set_val(PS4_LY, 100);
	set_val(PS4_TRIANGLE, 0);
	wait(70);
	set_val(PS4_LY, 100);
	set_val(PS4_TRIANGLE, 100);
	wait(60);
	set_val(PS4_LY, 100);
	set_val(PS4_TRIANGLE, 0);
	wait(50);
	set_val(PS4_LY, 100);
	set_val(PS4_TRIANGLE, 100);
	wait(80);
	set_val(PS4_LY, 100);
	set_val(PS4_TRIANGLE, 0);
	wait(20);
	set_val(PS4_LY, 0);
	wait(120);
	set_val(PS4_CIRCLE, 100);
	wait(50);
	set_val(PS4_CIRCLE, 0);
	wait(80);
	set_val(PS4_CIRCLE, 100);
	wait(40);
	set_val(PS4_CIRCLE, 0);
	wait(60);
	set_val(PS4_CIRCLE, 100);
	wait(80);
	set_val(PS4_CIRCLE, 0);
	wait(50);
	set_val(PS4_CIRCLE, 100);
	wait(90);
	set_val(PS4_CIRCLE, 0);
	i = 0;
}
