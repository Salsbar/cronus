main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
	//Crouch Light Kick 3x
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 100);
    wait(250);
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 100);
    set_val(XB360_A, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 100);
    set_val(XB360_A, 0);
    wait(325);
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 100);
    set_val(XB360_A, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 100);
    set_val(XB360_A, 0);
    wait(325);
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 100);
    set_val(XB360_A, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_DOWN, 0);
    set_val(XB360_A, 0);
    wait(50);
    //Double Knee Press
    set_val(XB360_LEFT, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_A, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_A, 0);

}

