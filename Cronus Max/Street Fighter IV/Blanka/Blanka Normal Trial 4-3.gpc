//Created and/or amended by Dr Marty. 
//I need to thank JayD101 for providing some of the source material.
//Also thanks to XxFrAsZeRxX for a crash course in CronusMax scripting.
//Lastly, thanks goes to James Nguyen (siky) for some details on game mechanics 

// Push enemy to the other end and activate with some space between the two. Mash Y+B during the script.

main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
	//Jump Heavy Punch
    set_val(XB360_UP, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_UP, 0);
    set_val(XB360_RIGHT,  0);
    wait(500);
    set_val(XB360_LEFT, 100);
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_RB, 0);
    wait(400);
    //Rock Crusher
    set_val(XB360_LEFT, 100);
    set_val(XB360_Y, 100);
    wait(20);
    set_val(XB360_LEFT, 100);
    set_val(XB360_Y, 0);
    //Rolling Attack
    wait(150);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_RB, 0);
    //EX Focus Attack (timing not perfect: mash Y+B right after roll hits)
	wait(50);
    set_val(XB360_Y, 100);
    set_val(XB360_B, 100);
    wait(150);
    set_val(XB360_Y, 0);
    set_val(XB360_B, 0);

}

