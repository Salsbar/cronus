// Move Dan into the corner. Don't stand too close. Just have both character's toes touch

main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
	//Heavy Kick
    set_val(XB360_RT, 100);
    wait(20);
    set_val(XB360_RT, 0);
    wait(975);
    //Crouch Light Kick
    set_val(XB360_DOWN, 100);
    set_val(XB360_A, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_A, 0);
    wait(50);
    

}

