// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
//#include <titanone.gph>
//#pragma METAINFO("SF4 Akuma Normal Trial 4-4", 1, 0, "XxFrAsZeRxX")

//Created and/or amended by Dr Marty. 
//I need to thank JayD101 for providing some of the source material.
//Also thanks to XxFrAsZeRxX for a crash course in CronusMax scripting.
//Lastly, thanks goes to James Nguyen (siky) for some details on game mechanics 

main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
	//EX Zanku Hadoken (Push Dan all the way into the corner. Make three quick dashes backwards. 
	//					This needs to be exactly 3 dashes. Don't do one dash, wait, another dash, etc. Just quickly dash 3 times)
    set_val(XB360_UP, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_UP, 0);
    set_val(XB360_RIGHT, 0);
    wait(500);
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_LB, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_LB, 0);
    wait(600);
    //Shakunetsu Hadoken
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 0);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_LEFT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_LEFT, 100);
    set_val(XB360_X, 100);
    wait(20);
    set_val(XB360_LEFT, 0);
    set_val(XB360_X, 0);
    wait(800);
    //Heavy Goshoryuken
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 0);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_RB, 0);
    

}

