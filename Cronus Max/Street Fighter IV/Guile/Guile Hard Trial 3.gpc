// REMOVE SLASHES ON LINE 2 AND 3 FOR TITAN TWO COMPATIBILITY!
//#include <titanone.gph>
//#pragma METAINFO("SF4 Guile Hard Trial 3", 1, 0, "XxFrAsZeRxX")

//Push the characters all the way to the right. Activate.

int i;

define lk = XB360_A;
define mk = XB360_B;
define hk = XB360_RT;

define lp = XB360_X;
define mp = XB360_Y;
define hp = XB360_RB;

define LY = XB360_LY;
define LX = XB360_LX;

define d = XB360_DOWN;
define r = XB360_RIGHT;
define l = XB360_LEFT;
define u = XB360_UP;

define p = XB360_LB;
define k = XB360_LT;

main 
{
	if(get_val(XB360_LS))
	{
		i = 1;
	}
	if(get_val(XB360_RS))
	{
		i = 0;
	}
	
	
	if(i==1)
	{
		combo_run(move1);
	}
	if(i==0)
	{
		combo_stop(move1);
	}
}

combo move1
{
	//Focus Attack
	set(mp);
	set(mk);
	wait(1000);
	rel(mp);
	rel(mk);
	call(dashf);
	wait(800);
	//Reverse Spin Kick
	set(r);
	set(hk);
	wait(25);
	set(d);
	wait(750);
	//Crouch Light Punch
	set(d);
	set(lp);
	wait(350);
	//Crouch Medium Punch
	set(d);
	set(mp);
	wait(200);
	//Flash Kick
	set(u);
	set(hk);
	wait(100);
	i = 0;
}

combo dashf
{
	set(r);
	wait(25);
	rel(r);
	wait(25);
	set(r);
	wait(25);
	rel(r);
	wait(25);
}

function set(button)
{
	set_val(button, 100);
}

function rel(button)
{
	set_val(button, 0);
}
