//I need to thank JayD101 for providing some of the source material.
//Also thanks to XxFrAsZeRxX for a crash course in CronusMax scripting.
//Lastly, thanks goes to James Nguyen (siky) for some details on game mechanics 

// Push Dan all the way to the right then back off slightly.

main {  if(get_val(XB360_LS)) combo_run(trial); 
        if(get_val(XB360_RS)) combo_stop(trial); 
}


combo trial {
	set_val(XB360_RIGHT, 100);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_B, 0);
    wait(150);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    wait(20);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    wait(325);
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_RB, 0);
    wait(150);
    set_val(XB360_DOWN, 100);
    wait(20);
    set_val(XB360_DOWN, 100);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_DOWN, 0);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_Y, 100);
    wait(20);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_Y, 0);
    wait(300);
    set_val(XB360_Y, 100);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_Y, 0);
    set_val(XB360_B, 0);
    wait(50);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    wait(20);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    wait(300);
    set_val(XB360_RIGHT, 100);
    set_val(XB360_B, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    set_val(XB360_B, 0);
    wait(150);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    wait(20);
    set_val(XB360_RIGHT, 100);
    wait(20);
    set_val(XB360_RIGHT, 0);
    wait(325);
    set_val(XB360_RB, 100);
    wait(20);
    set_val(XB360_RB, 0);
    

}

